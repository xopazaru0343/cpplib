{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++ Launch (GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}", 
            "args": [], 
            "stopAtEntry": false, 
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false, 
            "miDebuggerPath": "/usr/bin/gdb",
            "MIMode": "gdb", 
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C/C++: g++ build active file" 
        }
    ]
}